# Dockerfile.dev - FRONTEND - CHẠY MƯỢT Node 22 + Alpine + Vite 6 + Tailwind 4
FROM node:22-alpine

WORKDIR /app

# ÉP npm tải đúng binary cho Alpine (musl)
ENV npm_config_platform=linux
ENV npm_config_arch=x64
ENV npm_config_cache=/tmp/.npm
ENV npm_config_build_from_source=false

# Cài npm mới nhất + tools
RUN apk add --no-cache python3 make g++ git \
    && npm i -g npm@10.9.0 --force \
    && npm config set fund false \
    && npm config set update-notifier false

# Tạo cache sạch
RUN rm -rf /tmp/.npm && mkdir -p /tmp/.npm

COPY package*.json ./

# DÍNH ĐÍCH: Install + rebuild + cài thủ công 2 binary bị thiếu
RUN npm cache clean --force

# Install bình thường
RUN npm install --legacy-peer-deps --force

# BƯỚC QUAN TRỌNG NHẤT: CÀI THỦ CÔNG 2 BINARY CHO ALPINE
RUN npm install --save-optional --force \
    @rollup/rollup-linux-x64-musl \
    lightningcss-linux-x64-musl

# Rebuild lại lần cuối
RUN npm rebuild --verbose

COPY . .

EXPOSE 5173

CMD ["sh", "-c", "npm run dev -- --host 0.0.0.0"]